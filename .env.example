NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
DATABASE_USER=hodhod
DATABASE_PASSWORD=hodhod_local_only
DATABASE_NAME=hodhod
JWT_SECRET=replace-with-a-long-random-local-secret
AUTH_DEV_OTP_ENABLED=false

# Use independent random secrets of at least 32 characters.
AUTH_OTP_SECRET=replace-with-an-independent-random-secret
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Hodhod <no-reply@hodhod.test>
SMTP_SECURE=false
SMTP_ALLOW_INSECURE_LOCAL=true
# SMTP_USER=
# SMTP_PASSWORD=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_REQUEST_EMAIL_LIMIT=5
AUTH_REQUEST_IP_LIMIT=20
AUTH_VERIFY_EMAIL_LIMIT=10
AUTH_VERIFY_IP_LIMIT=30
AUTH_SESSION_TTL_SECONDS=604800

# Optional: total points for 0,1,2,... best stars (no built-in table; unset means stars earn no points)
# SCORING_STAR_POINTS=0,0,0,20,30,40
# SCORING_DEFAULT_MAX_STARS=5
# SCORING_DEFAULT_PASS_STARS=3

# Documentation pages are open only in development. Elsewhere they stay off unless enabled with credentials.
# DOCS_ENABLED=true
# DOCS_USER=docs
# DOCS_PASSWORD=at-least-16-characters

# Production: set NODE_ENV=production and every value below (the API refuses unsafe settings). Behind a reverse proxy:
# TRUST_PROXY=1
# API_PUBLISH_PORT=3000
